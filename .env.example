# === Food Order - Environment Variables ===
# Bu dosyayı kopyalayıp .env olarak kaydet ve değerleri doldur.
# Tek kaynak: Tüm servisler bu dosyadan beslenir.

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_CONNECTION_STRING="Server=yrlmz-food-order-mysql;Database=FoodOrderApp;Uid=root;Pwd=CHANGE_ME;convert zero datetime=True;Min Pool Size=0;Max Pool Size=100;"

# Local Development DB (backend doğrudan çalıştırılınca)
LOCAL_DB_CONNECTION_STRING="Server=localhost;Database=FoodOrderApp;Uid=root;Pwd=CHANGE_ME;convert zero datetime=True;Connection Timeout=2147483;Min Pool Size=0;Max Pool Size=100;"

# Redis
REDIS_HOST=yrlmz-food-order-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (min 32 karakter, rastgele üret)
TOKEN_SECURITY_KEY=CHANGE_ME_USE_STRONG_RANDOM_KEY_MIN_32_CHARS

# Cloudflare R2 / AWS S3
R2_DOMAIN=https://cdn.example.com
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com/bucket
R2_BUCKET=your-bucket
R2_ACCESS_KEY=YOUR_ACCESS_KEY
R2_SECRET_KEY=YOUR_SECRET_KEY
R2_TOKEN=YOUR_TOKEN

# SMTP (Email)
SMTP_SERVER=smtp.mandrillapp.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AI Support (Claude API)
AI_SUPPORT_API_KEY=
AI_SUPPORT_MODEL=claude-sonnet-4-20250514

# API URL (frontend'ler için)
API_BASE_URL=https://food-order-api.yrlmzteknoloji.com/v1
NEXT_PUBLIC_API_BASE_URL=https://food-order-api.yrlmzteknoloji.com

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Server (deploy)
SERVER_HOST=
SERVER_USER=
SERVER_PASS=
REMOTE_DIR=
