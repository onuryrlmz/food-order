# === Docker Compose Environment Variables ===

# Registry & Versioning
REGISTRY=ghcr.io/onuryorulmaz
TAG=latest

# Domains (Traefik routing)
API_DOMAIN=api.esnaftan.com
ADMIN_DOMAIN=admin.esnaftan.com
SELLER_DOMAIN=seller.esnaftan.com
APP_DOMAIN=app.esnaftan.com

# MySQL
MYSQL_ROOT_PASSWORD=StrongPassword123!
DB_CONNECTION_STRING=Server=food-order-mysql;Database=FoodOrderApp;Uid=root;Pwd=StrongPassword123!;convert zero datetime=True;Min Pool Size=0;Max Pool Size=100;

# Redis
REDIS_HOST=food-order-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Token
TOKEN_SECURITY_KEY=YourSuperSecretKeyAtLeast32Characters!

# AWS S3 / Cloudflare R2
S3_DOMAIN=https://cdn.esnaftan.com
S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
S3_BUCKET=food-order
S3_ACCESS_KEY=
S3_SECRET_KEY=

# SMTP (Email)
SMTP_SERVER=smtp.mandrillapp.com
SMTP_PORT=587
SMTP_USER=noreply@esnaftan.com
SMTP_PASSWORD=
SMTP_FROM=noreply@esnaftan.com

# AI Support (Claude API)
AI_SUPPORT_API_KEY=
AI_SUPPORT_MODEL=claude-sonnet-4-20250514
