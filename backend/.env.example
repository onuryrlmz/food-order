# =============================================================
# FoodOrder Backend — Environment Variables (ÖRNEK)
# Bu dosyayı kopyalayıp .env olarak kaydet ve değerleri doldur.
# =============================================================

# --- Veritabanı ---
ConnectionStrings__FoodOrderApp=Server=localhost;Database=FoodOrderApp;Uid=root;Pwd=SIFRE;convert zero datetime=True;Connection Timeout=2147483;Min Pool Size=0;Max Pool Size=100;

# --- Cloudflare R2 / AWS S3 ---
AwsS3__Domain=https://cdn.example.com
AwsS3__Endpoint=https://ACCOUNT_ID.r2.cloudflarestorage.com
AwsS3__BucketName=your-bucket
AwsS3__AccessKey=YOUR_ACCESS_KEY
AwsS3__SecretKey=YOUR_SECRET_KEY

# --- JWT (min 32 karakter, rastgele üret) ---
TokenOptions__SecurityKey=CHANGE_ME_USE_STRONG_RANDOM_KEY_MIN_32_CHARS

# --- Redis ---
Redis__Host=127.0.0.1
Redis__Port=6379
Redis__Password=
Redis__Ssl=false

# --- Mail (SMTP) ---
MailSettings__Password=YOUR_SMTP_PASSWORD
MailSettings__UserName=your@email.com
MailSettings__SenderEmail=your@email.com

# --- CORS ---
WebAPIConfiguration__AllowedOrigins__0=https://yourdomain.com
