{
  "AllowedHosts": "*",
  "CacheSettings": {
    "SlidingExpiration": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SeriLogConfigurations": {
    "FileLogConfiguration": {
      "FolderPath": "/logs/"
    }
  },
  "TokenOptions": {
    "AccessTokenExpiration": 60,
    "Audience": "foodorder-api",
    "Issuer": "foodorder-api",
    "RefreshTokenTTL": 7
  },
  "MailSettings": {
    "AuthenticationRequired": true,
    "SenderFullName": "FoodOrder"
  },
  "WebAPIConfiguration": {
    "APIDomain": "http://localhost:3762/v1",
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  }
}
